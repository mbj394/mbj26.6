const dots=()=>document.querySelectorAll('#dots i').forEach((x,i)=>x.classList.toggle('on',i<pin.length));
function lockUI(l){
  LG=l||{co:S.shop,code:CODE};pin='';
  if($('#dlg').open)$('#dlg').close();
  $('#app').hidden=true;$('#gate').hidden=true;$('#lock').hidden=false;$('#fpbox').hidden=true;
  $('#lm').textContent='الدفتر مقفل لحماية بياناتك.';dots();
}
function unlock(){$('#lock').hidden=true;booted?($('#app').hidden=false):boot(LG.co,LG.code)}
function wrong(m){$('#lm').textContent=m;$('#dots').classList.add('bad');setTimeout(()=>{$('#dots').classList.remove('bad');pin='';dots()},350)}
async function key(k){
  if(k=='b')pin=pin.slice(0,-1);else if(pin.length<4)pin+=k;
  dots();if(pin.length<4)return;
  const lu=+ls('.lu')||0;
  if(Date.now()<lu)return wrong('محاولات كثيرة. حاول بعد '+Math.ceil((lu-Date.now())/1000)+' ثانية');
  if(await ph(pin)==ls('.pin')){ls('.fl',null);unlock();return}
  const f=(+ls('.fl')||0)+1;ls('.fl',f);
  if(f>=5){ls('.lu',Date.now()+30000*(f-4));wrong('محاولات كثيرة. انتظر قليلاً')}else wrong('الرمز غير صحيح')
}
document.addEventListener('keydown',e=>{if($('#lock').hidden||e.target.tagName=='INPUT')return;if(/^\d$/.test(e.key))key(e.key);else if(e.key=='Backspace')key('b')});
document.addEventListener('visibilitychange',()=>{
  if(!booted||!ls('.pin'))return;
  if(document.hidden)away=Date.now();
  else if(away){const lt=ls('.lt'),s=lt==null?60:+lt;if(Date.now()-away>=s*1000)lockUI();away=0}
});
function pinDlg(){
  const d=$('#dlg'),has=ls('.pin'),lt=ls('.lt')||'60',pi='type="password" inputmode="numeric" maxlength="4" autocomplete="off"';
  d.dataset.t='k';
  d.innerHTML=`<h3>${has?'إعدادات رمز PIN':'تعيين رمز PIN'}</h3><p class="mu" style="font-size:13px;margin-bottom:12px">${has?'اترك الرمز الجديد فارغاً إذا بدك تغيير القفل التلقائي فقط.':'رمز من 4 أرقام يُطلب عند فتح الدفتر، ويحمي بياناتك من أي شخص يستعمل جهازك.'}</p>
  ${has?`<label>الرمز الحالي<input id="k0" ${pi}></label>`:''}
  <label>${has?'رمز جديد (اختياري)':'رمز PIN'}<input id="k1" ${pi}></label><label>تأكيد الرمز<input id="k2" ${pi}></label>
  <label>القفل التلقائي<select id="k3" style="width:100%">${[['0','فوراً عند مغادرة التطبيق'],['60','بعد دقيقة'],['300','بعد 5 دقائق']].map(o=>`<option value="${o[0]}"${o[0]==lt?' selected':''}>${o[1]}</option>`).join('')}</select></label>
  <div class="ft" style="flex-wrap:wrap">${has?'<button class="btn" data-act="lockn">قفل الآن</button><button class="btn d2" data-act="pinrm">إزالة الـ PIN</button>':''}<button class="btn" data-act="cancel">إلغاء</button><button class="btn pri" data-act="ok">حفظ</button></div>`;
  d.showModal();
}
async function pinSave(){
  const has=ls('.pin'),g=i=>($('#'+i)||{}).value||'',bad=i=>{$('#'+i).classList.add('bad');$('#'+i).focus()},n=g('k1');
  if(has&&await ph(g('k0'))!=has)return bad('k0');
  if(n||!has){if(!/^\d{4}$/.test(n))return bad('k1');if(n!=g('k2'))return bad('k2');ls('.pin',await ph(n))}
  ls('.lt',g('k3'));$('#dlg').close();toast(has?'تم تحديث إعدادات PIN':'تم تعيين رمز PIN');
}
async function pinRm(){
  if(await ph($('#k0').value)!=ls('.pin')){$('#k0').classList.add('bad');$('#k0').focus();return}
  ls('.pin',null);$('#dlg').close();toast('تمت إزالة رمز PIN');
}
