async function hh(c){const b=await crypto.subtle.digest('SHA-256',new TextEncoder().encode(SALT+c));return[...new Uint8Array(b).slice(0,8)].map(x=>x.toString(16).padStart(2,'0')).join('')}
const norm=c=>c.toUpperCase().replace(/[^A-Z0-9]/g,'');
async function valid(c){try{return c.length==6&&H.has(await hh(c))}catch(e){return null}}
function boot(co,code){
  K='daftarna.v2.'+code;CODE=code;booted=true;S={shop:'',cur:'د.أ',cs:[]};
  try{const r=localStorage.getItem(K);if(r)S=JSON.parse(r)}catch(e){}
  mig();if(co)S.shop=co;save();
  try{localStorage.setItem(LK,JSON.stringify({co:S.shop,code}))}catch(e){}
  $('#gate').hidden=true;$('#app').hidden=false;sel=null;
  $('#cur').value=S.cur;$('#shop').value=S.shop;render();
  let lb=0;try{lb=+localStorage.getItem(K+'.bk')||0}catch(e){}
  if(S.cs.length&&Date.now()-lb>7*DAY)setTimeout(()=>toast('ننصحك بتنزيل نسخة احتياطية الآن'),600);
}
async function login(){
  const co=$('#co').value.trim(),code=norm($('#code').value),e=$('#err'),v=await valid(code);
  if(v){boot(co,code);return}
  e.hidden=false;
  e.innerHTML=v===null?'تعذّر التحقق من الرمز. افتح الصفحة عبر رابط https.':`اشتراكك غير موجود. يرجى التواصل مع الدعم عبر الواتساب.<a class="btn wa" target="_blank" rel="noopener" href="${wal(`مرحباً، أواجه مشكلة في الدخول إلى البرنامج.\nاسم الشركة: ${co}\nالرمز المُدخل: ${code}\nالمشكلة: `)}">تواصل مع الدعم</a>`;
}
