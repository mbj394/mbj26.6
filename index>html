<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>دفترنا | دفتر الديون للمحلات</title>
<link rel="manifest" href="manifest.webmanifest"><meta name="theme-color" content="#2B47D6"><link rel="icon" href="icon-192.png"><link rel="apple-touch-icon" href="icon-192.png"><meta name="mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-capable" content="yes">
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{color-scheme:light dark;--bg:#F3F4F7;--sf:#fff;--ink:#141B2D;--mu:#697086;--ln:#E3E6EE;--ac:#2B47D6;--acs:#E8ECFD;--on:#fff;--debt:#C4372D;--debts:#FCEBE9;--ok:#1B8A57;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0F1320;--sf:#181E30;--ink:#EEF0F7;--mu:#98A0B8;--ln:#2A3149;--ac:#8EA2FF;--acs:#232C55;--on:#0F1320;--debt:#FF7B6E;--debts:#3A1F24;--ok:#4AD18B}}
:root[data-theme="dark"]{--bg:#0F1320;--sf:#181E30;--ink:#EEF0F7;--mu:#98A0B8;--ln:#2A3149;--ac:#8EA2FF;--acs:#232C55;--on:#0F1320;--debt:#FF7B6E;--debts:#3A1F24;--ok:#4AD18B}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box;margin:0}
body{background:var(--bg);color:var(--ink);font:400 15px/1.6 'IBM Plex Sans Arabic',Tahoma,system-ui,sans-serif}
.app{max-width:1060px;margin:0 auto;padding:18px 16px 48px}
button,input,select,a{font:inherit;color:inherit}
:focus-visible{outline:2px solid var(--ac);outline-offset:2px}
.top{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.logo{width:36px;height:36px;border-radius:10px;background:var(--ac);color:var(--on);display:grid;place-items:center;font-weight:700;font-size:20px}
.top h1{font-size:20px;font-weight:700;margin-inline-end:auto}
.top input,.top select,dialog input{border:1px solid var(--ln);background:var(--sf);border-radius:10px;padding:8px 12px;width:100%}
.top input{width:170px}.top select{width:auto}
.hero{background:var(--sf) repeating-linear-gradient(to bottom,transparent 0 33px,var(--ln) 33px 34px);border:1px solid var(--ln);border-radius:18px;padding:22px 20px 18px 20px;padding-inline-start:70px;margin:18px 0;position:relative;overflow:hidden}
.hero::before{content:"";position:absolute;inset-block:0;inset-inline-start:46px;width:2px;background:var(--debt);opacity:.4}
.hero p{color:var(--mu)}
.big{font-size:clamp(40px,9vw,66px);font-weight:700;line-height:1.2;color:var(--debt);font-variant-numeric:tabular-nums}
.big small{font-size:.3em;color:var(--mu);font-weight:500}
#st{display:flex;flex-wrap:wrap;gap:8px 32px;margin-top:12px;background:var(--sf);padding:6px 0;width:fit-content;max-width:100%}
#st div{color:var(--mu);font-size:13px}#st b{display:block;font-size:20px;color:var(--ink);font-variant-numeric:tabular-nums}
.cols{display:grid;grid-template-columns:minmax(0,380px) 1fr;gap:16px;align-items:start}
.card{background:var(--sf);border:1px solid var(--ln);border-radius:16px;overflow:hidden}
.tools{padding:12px;display:grid;gap:10px;border-bottom:1px solid var(--ln)}
.tools input{border:1px solid var(--ln);background:var(--bg);border-radius:10px;padding:9px 12px;width:100%}
.chips{display:flex;gap:6px;align-items:center}.chips .btn:nth-last-child(2){margin-inline-start:auto}
.chip{border:1px solid var(--ln);background:transparent;border-radius:99px;padding:3px 12px;font-size:13px;cursor:pointer}
.chip.on{background:var(--acs);border-color:var(--ac);color:var(--ac)}
.row{display:flex;align-items:center;gap:12px;width:100%;padding:12px 14px;border:0;border-bottom:1px solid var(--ln);background:transparent;text-align:start;cursor:pointer}
.row.on{background:var(--acs)}
.av{width:38px;height:38px;border-radius:50%;background:var(--acs);color:var(--ac);display:grid;place-items:center;font-weight:700;flex:none}
.nm{flex:1;min-width:0;display:flex;flex-direction:column}.nm small{color:var(--mu)}
.tag{font-style:normal;background:var(--debts);color:var(--debt);padding:1px 8px;border-radius:99px;font-size:12px;width:fit-content}
.am{font-weight:700;white-space:nowrap;font-variant-numeric:tabular-nums}
.d{color:var(--debt)}.o{color:var(--ok)}.mu{color:var(--mu)}
.btn{border:1px solid var(--ln);background:var(--sf);padding:8px 14px;border-radius:10px;font-weight:500;font-size:14px;cursor:pointer;text-decoration:none;display:inline-block}
.pri{background:var(--ac);border-color:var(--ac);color:var(--on)}
.pay{background:var(--ok);border-color:var(--ok);color:var(--on)}
.d2{border-color:var(--debt);color:var(--debt)}
.wa{border-color:var(--ok);color:var(--ok)}
.emp{padding:28px 18px;text-align:center;color:var(--mu)}.emp b{display:block;color:var(--ink);font-size:17px;margin-bottom:4px}.emp .btn{margin:12px 3px 0}
#det{padding:18px;position:sticky;top:16px}
#det h2{font-size:22px}
.bl{margin:14px 0;padding:12px 16px;border-radius:12px;background:var(--bg);display:flex;justify-content:space-between;align-items:baseline;gap:8px}
.bl strong{font-size:30px;font-variant-numeric:tabular-nums}.bl small{font-size:14px;color:var(--mu)}
.acts{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:16px}
.tr{display:grid;grid-template-columns:1fr 58px 58px 66px 22px;gap:6px;align-items:center;padding:9px 0;border-bottom:1px solid var(--ln);font-size:14px;font-variant-numeric:tabular-nums}
.tr small{display:block;color:var(--mu);font-size:12px}.tr span:not(:first-child){text-align:end}
.th{color:var(--mu);font-size:12px;padding-top:0}
.x{border:0;background:none;color:var(--mu);cursor:pointer;font-size:12px;padding:0}
.del{margin-top:20px;color:var(--mu);font-size:13px}
.back{display:none;margin-bottom:12px}
dialog{border:0;border-radius:18px;padding:22px;width:min(92vw,380px);background:var(--sf);color:var(--ink)}
dialog::backdrop{background:rgba(10,14,30,.55)}
dialog h3{margin-bottom:12px}dialog label{display:block;margin-bottom:12px;font-size:13px;color:var(--mu)}
dialog input.bad{border-color:var(--debt)}
.ft{display:flex;gap:8px;justify-content:flex-end}
#toast{position:fixed;inset-inline:0;bottom:calc(24px + env(safe-area-inset-bottom,0px));margin:auto;width:fit-content;background:var(--ink);color:var(--bg);padding:9px 18px;border-radius:99px;opacity:0;transform:translateY(12px);transition:.25s;pointer-events:none;z-index:50}
#toast.on{opacity:1;transform:none}
@media(max-width:859px){.cols{grid-template-columns:1fr}#det{display:none}#det.open{display:block;position:fixed;inset:0;z-index:20;overflow:auto;border-radius:0;border:0;padding:calc(16px + env(safe-area-inset-top,0px)) 16px calc(24px + env(safe-area-inset-bottom,0px))}.back{display:inline-block}}
@media(prefers-reduced-motion:reduce){*{transition:none!important}}
#gate{display:grid;place-items:center;min-height:85vh;padding:24px 16px}#gate[hidden]{display:none}
#gate .card{width:min(100%,400px);padding:28px 24px}#gate h2{margin:14px 0 4px;font-size:22px}
#gate label{display:block;margin-top:14px;font-size:13px;color:var(--mu)}
#gate input{border:1px solid var(--ln);background:var(--bg);border-radius:10px;padding:11px 14px;width:100%;margin-top:4px}
#gate #code{direction:ltr;text-align:center;letter-spacing:.3em;font-size:22px;font-weight:700;text-transform:uppercase}
#gate .btn{width:100%;text-align:center;margin-top:14px;padding:11px}
#gate .err{margin-top:14px;padding:12px;border-radius:10px;background:var(--debts);color:var(--debt);font-size:14px}
#gate .sub{margin-top:18px;border-top:1px solid var(--ln);padding-top:14px;text-align:center;color:var(--mu);font-size:13px}
[hidden]{display:none!important}
.big{display:flex;flex-wrap:wrap;gap:0 28px}
.bl{flex-wrap:wrap;gap:8px 28px;justify-content:flex-start}.bl>div>small{display:block;font-size:13px}
dialog select{border:1px solid var(--ln);background:var(--sf);border-radius:10px;padding:8px}
.x.rc{color:var(--ac);margin-inline-start:6px;font-size:12px}
.rh{display:flex;justify-content:space-between;align-items:center;border-bottom:2px solid var(--ink);padding-bottom:10px;margin-bottom:6px;font-size:18px}
.rr{display:flex;justify-content:space-between;gap:12px;padding:10px 0;border-bottom:1px dashed var(--ln)}.rr>span{color:var(--mu)}
.rr.sg{margin-top:34px;border:0}.rr.sg span{border-top:1px solid var(--mu);padding-top:6px;min-width:110px;text-align:center}
@media print{html:root:not([data-print]){--sf:#fff;--ink:#000;--mu:#555;--ln:#bbb;--bg:#fff;--ok:#1B7A4B}.app,#gate,#toast,.no{display:none!important}dialog{position:static;width:100%;box-shadow:none;border:1px solid #000}}
#lock{display:grid;place-items:center;min-height:85vh;padding:24px 16px}
#lock .card{width:min(100%,340px);padding:28px 24px;text-align:center}#lock .logo{margin:0 auto}#lock h2{margin:14px 0 4px;font-size:22px}
#lock input{border:1px solid var(--ln);background:var(--bg);border-radius:10px;padding:10px 14px;width:100%;margin-top:10px;text-align:center}
.dots{display:flex;justify-content:center;gap:14px;margin:18px 0}.dots i{width:14px;height:14px;border-radius:50%;border:2px solid var(--ac)}
.dots i.on{background:var(--ac)}.dots.bad{animation:sh .3s}@keyframes sh{25%{transform:translateX(-8px)}75%{transform:translateX(8px)}}
.pad{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;direction:ltr;margin-bottom:14px}
.pad button{height:56px;border-radius:14px;border:1px solid var(--ln);background:var(--bg);color:var(--ink);font-size:22px;font-weight:500;cursor:pointer}
.pad button[data-v=b]{font-size:15px}
</style>
</head>
<body>
<div id="gate"><div class="card">
  <div class="logo">د</div><h2>أهلاً بك في دفترنا</h2><p class="mu">أدخل بيانات اشتراكك لفتح دفترك.</p>
  <label>اسم الشركة<input id="co" autocomplete="organization"></label>
  <label>رقم الاشتراك (6 رموز)<input id="code" maxlength="6" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="A7K9PX"></label>
  <div id="err" class="err" hidden></div>
  <button class="btn pri" id="go">دخول</button>
  <div class="sub">لست مشتركاً في برنامجنا؟<a class="btn wa" id="sub" target="_blank" rel="noopener">اشترك الآن عبر واتساب</a></div>
</div></div>
<div id="lock" hidden><div class="card">
  <div class="logo">د</div><h2>أدخل رمز PIN</h2><p class="mu" id="lm">الدفتر مقفل لحماية بياناتك.</p>
  <div class="dots" id="dots"><i></i><i></i><i></i><i></i></div>
  <div class="pad" id="pad"></div>
  <button class="btn" data-act="fp">نسيت رمز PIN؟</button>
  <div id="fpbox" hidden><input id="fpc" maxlength="6" autocomplete="off" placeholder="أدخل رقم الاشتراك" style="direction:ltr;text-transform:uppercase"><button class="btn pri" data-act="fpgo" style="margin-top:10px;width:100%">تأكيد وإزالة الـ PIN</button></div>
</div></div>
<div class="app" id="app" hidden>
  <div class="top">
    <div class="logo">د</div><h1>دفترنا</h1>
    <input id="shop" placeholder="اسم محلك" aria-label="اسم المحل">
    <select id="cur" aria-label="العملة الافتراضية" title="العملة الافتراضية"></select>
    <button class="btn pri" id="inst" data-act="inst" hidden>تثبيت التطبيق</button>
    <button class="btn" data-act="bk">نسخة احتياطية</button>
    <button class="btn" data-act="rs">استرجاع</button>
    <button class="btn" data-act="pin">رمز PIN</button>
    <button class="btn" data-act="out">خروج</button>
    <input id="rf" type="file" accept=".json,application/json" hidden>
  </div>
  <section class="hero">
    <p>إجمالي الديون المستحقة لك</p>
    <div class="big" id="owed"></div>
    <div id="st"></div>
  </section>
  <div class="cols">
    <div class="card">
      <div class="tools">
        <input id="q" type="search" placeholder="ابحث بالاسم أو الرقم" aria-label="بحث">
        <div class="chips">
          <button class="chip on" data-act="flt" data-v="all">الكل</button>
          <button class="chip" data-act="flt" data-v="late">المتأخرون</button>
          <button class="btn" data-act="imp">استيراد Excel</button>
          <button class="btn pri" data-act="newc">إضافة زبون</button>
        </div>
      </div>
      <div id="list"></div>
      <p class="emp" style="font-size:12px;padding:12px;border-top:1px solid var(--ln)">بياناتك محفوظة على هذا الجهاز فقط. نزّل نسخة احتياطية بشكل دوري. للتثبيت على الآيفون: مشاركة ثم إضافة إلى الشاشة الرئيسية.</p>
    </div>
    <div class="card" id="det"></div>
  </div>
</div>
<dialog id="dlg"></dialog>
<div id="toast" role="status"></div>
<script>
const $=s=>document.querySelector(s),DAY=864e5;let K='',CODE='',booted=false;
let S={shop:'',cur:'د.أ',cs:[]},sel=null,q='',flt='all';
const save=()=>{try{localStorage.setItem(K,JSON.stringify(S))}catch(e){}};
const uid=()=>Math.random().toString(36).slice(2,9);
const CURS=['د.أ','ر.س','د.إ','ج.م','ل.ل','ل.س','د.ع','$','€'];
const r2=x=>Math.round(x*100)/100;
const bals=c=>{const o={};c.tx.forEach(t=>o[t.c]=r2((o[t.c]||0)+t.a));return o};
const bal=(c,k)=>bals(c)[k]||0;
const owes=c=>Object.entries(bals(c)).filter(e=>e[1]>0);
const show=o=>Object.entries(o).filter(e=>Math.abs(e[1])>0).map(e=>fmt(e[1])+' '+e[0]).join(' + ');
const mig=()=>S.cs.forEach(c=>c.tx.forEach(t=>{t.c=t.c||S.cur}));
const fmt=n=>Math.abs(n).toLocaleString('en-US',{maximumFractionDigits:2});
const esc=s=>String(s).replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
const last=c=>c.tx.length?Math.max(...c.tx.map(t=>t.d)):0;
const days=c=>Math.floor((Date.now()-last(c))/DAY);
const late=c=>owes(c).length>0&&days(c)>=30;
const dt=t=>new Date(t).toLocaleDateString('ar-u-nu-latn',{day:'numeric',month:'short',year:'2-digit'});
const cur=()=>S.cs.find(c=>c.id==sel);
const toast=m=>{const t=$('#toast');t.textContent=m;t.classList.add('on');clearTimeout(toast.h);toast.h=setTimeout(()=>t.classList.remove('on'),2200)};

const wu=(p,m)=>`https://wa.me/${p.replace(/\D/g,'').replace(/^00/,'')}?text=${encodeURIComponent(m)}`;
function wl(c,k){
  const shop=S.shop||'محلّنا';
  const m=k=='r'?`مرحباً ${c.name}،\nتذكير ودّي من ${shop}: رصيدك المستحق ${owes(c).map(e=>fmt(e[1])+' '+e[0]).join(' + ')}.\nنرجو التسديد في أقرب وقت. شكراً لتعاملك معنا.`
  :`كشف حساب ${c.name} - ${shop}\n`+[...c.tx].sort((x,y)=>x.d-y.d).map(t=>`${dt(t.d)}: ${t.a>0?'دين':'دفعة'} ${fmt(t.a)} ${t.c}${t.n?' ('+t.n+')':''}`).join('\n')+`\nالرصيد: ${show(bals(c))||'مسدّد'}`;
  return wu(c.phone,m);
}

function render(){
  const cs=S.cs,m=Date.now()-30*DAY,T={},P={};
  cs.forEach(c=>{Object.entries(bals(c)).forEach(([k,v])=>{if(v>0)T[k]=r2((T[k]||0)+v)});c.tx.forEach(t=>{if(t.a<0&&t.d>=m)P[t.c]=r2((P[t.c]||0)-t.a)})});
  const ks=Object.keys(T);
  $('#owed').innerHTML=ks.length?ks.map(k=>`<span>${fmt(T[k])} <small>${k}</small></span>`).join(''):`<span>0 <small>${S.cur}</small></span>`;
  $('#st').innerHTML=`<div><b>${cs.filter(c=>owes(c).length).length}</b>زبون عليهم دين</div><div><b class="d">${cs.filter(late).length}</b>متأخرون أكثر من 30 يوماً</div><div><b class="o">${show(P)||0}</b>تم تحصيله آخر 30 يوماً</div>`;
  list();det();
}

function list(){
  document.querySelectorAll('.chip').forEach(x=>x.classList.toggle('on',x.dataset.v==flt));
  const sc=c=>bal(c,S.cur)*1e3+owes(c).length;
  const L=S.cs.filter(c=>(c.name+c.phone).includes(q)&&(flt=='all'||late(c))).sort((a,b)=>sc(b)-sc(a));
  const am=c=>{const o=owes(c);if(o.length)return `<span class="am d">${o.map(e=>fmt(e[1])+' '+e[0]).join('<br>')}</span>`;const n=Object.entries(bals(c)).filter(e=>e[1]<0);return `<span class="am o">${n.length?'له '+n.map(e=>fmt(e[1])+' '+e[0]).join(' + '):'مسدّد'}</span>`};
  $('#list').innerHTML=L.length?L.map(c=>`<button class="row${c.id==sel?' on':''}" data-act="open" data-id="${c.id}"><span class="av">${esc(c.name[0])}</span><span class="nm"><b>${esc(c.name)}</b><small>${late(c)?`<i class="tag">متأخر ${days(c)} يوم</i>`:last(c)?'آخر حركة '+dt(last(c)):'بدون حركات'}</small></span>${am(c)}</button>`).join('')
  :S.cs.length?'<p class="emp">لا يوجد زبائن مطابقون.</p>'
  :'<div class="emp"><b>دفترك فاضي</b>أضف أول زبون وسجّل ديونه، أو استورد زبائنك من Excel، أو جرّب ببيانات تجريبية.<br><button class="btn pri" data-act="newc">إضافة زبون</button><button class="btn" data-act="imp">استيراد Excel</button><button class="btn" data-act="demo">بيانات تجريبية</button></div>';
}

function det(){
  const c=cur(),el=$('#det');
  el.classList.toggle('open',!!c);
  if(!c){el.innerHTML='<p class="emp">اختر زبوناً لعرض كشف حسابه.</p>';return}
  const run={},bl=Object.entries(bals(c)).filter(e=>Math.abs(e[1])>0);
  const rows=[...c.tx].sort((x,y)=>x.d-y.d).map(t=>({...t,r:run[t.c]=r2((run[t.c]||0)+t.a)})).reverse();
  el.innerHTML=`<button class="btn back" data-act="back">رجوع للقائمة</button>
  <h2>${esc(c.name)}</h2><p class="mu">${esc(c.phone)||'لا يوجد رقم واتساب'}</p>
  <div class="bl">${bl.length?bl.map(([k,v])=>`<div><small>${v>0?'مستحق عليه':'له عندك'}</small><strong class="${v>0?'d':'o'}">${fmt(v)} <small>${k}</small></strong></div>`).join(''):'<strong class="o">الحساب مسدّد</strong>'}</div>
  <div class="acts"><button class="btn d2" data-act="debt">تسجيل دين</button><button class="btn pay" data-act="pay">تسجيل دفعة</button>${owes(c).length?`<a class="btn wa" target="_blank" rel="noopener" href="${wl(c,'r')}">تذكير بالواتساب</a>`:''}<a class="btn wa" target="_blank" rel="noopener" href="${wl(c,'s')}">إرسال كشف الحساب</a></div>
  <div class="tr th"><span>البيان</span><span>دين</span><span>دفعة</span><span>الرصيد</span><i></i></div>
  ${rows.map(t=>`<div class="tr"><span><b>${esc(t.n||(t.a>0?'دين':'دفعة'))}</b><small>${dt(t.d)} · ${t.c}${t.a<0?`<button class="x rc" data-act="rcp" data-id="${t.id}">سند قبض</button>`:''}</small></span><span class="d">${t.a>0?fmt(t.a):''}</span><span class="o">${t.a<0?fmt(t.a):''}</span><span>${t.r<0?'−':''}${fmt(t.r)}</span><button class="x" data-act="deltx" data-id="${t.id}" aria-label="حذف الحركة">حذف</button></div>`).join('')||'<p class="emp">لا توجد حركات بعد. سجّل أول دين.</p>'}
  <button class="btn del" data-act="delc">حذف الزبون</button>`;
}

function ask(t){
  const d=$('#dlg'),f='<div class="ft"><button class="btn" data-act="cancel">إلغاء</button><button class="btn pri" data-act="ok">'+(t=='i'?'استيراد':'حفظ')+'</button></div>';
  d.dataset.t=t;
  d.innerHTML=t=='c'
