    R.slice(hd?1:0).forEach(r=>{const name=String(r[n]).trim();if(!name)return;const k=String(r[cu]).trim(),a=parseFloat(dg(r[am]));
      pend.push({name,phone:String(r[ph]).trim(),a:isNaN(a)?0:a,c:CURS.includes(k)?k:CM[k.toLowerCase()]||S.cur})});
    const T={};pend.forEach(r=>{if(r.a>0)T[r.c]=r2((T[r.c]||0)+r.a)});
