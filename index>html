async function readX(f){
  const p=$('#xp');p.textContent='جارٍ قراءة الملف...';pend=[];
  try{
    await lib();
    const w=XLSX.read(await f.arrayBuffer(),{type:'array'}),R=XLSX.utils.sheet_to_json(w.Sheets[w.SheetNames[0]],{header:1,defval:''});
    const h=(R[0]||[]).map(x=>String(x).toLowerCase()),ix=(re,d)=>{const i=h.findIndex(x=>re.test(x));return i<0?d:i};
    const hd=h.some(x=>/اسم|name|هاتف|phone|مبلغ|رصيد|amount|balance/.test(x));
    const n=ix(/اسم|name|زبون|عميل/,0),ph=ix(/هاتف|جوال|موبايل|واتس|phone|mobile|tel/,1),am=ix(/مبلغ|رصيد|دين|amount|balance|debt/,2),cu=ix(/عملة|currency/,3);
